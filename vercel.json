{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/pdfjs-dist/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
