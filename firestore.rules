rules_version = '2';

// Plasgain CRM data store.
//
// This previously read `allow read, write: if true` on `/{document=**}`, which
// left every account, contact, opportunity, pricing record and controlled
// document open to anyone holding the web config that ships in the client
// bundle. Callers must now present a Firebase identity; `ensureFirebaseAuth()`
// in src/utils/firebase.ts signs in before any read or write.
//
// This is the floor, not the ceiling. Anonymous auth proves a request came
// through Firebase, not who sent it. Per-rep identity and role-gated writes
// (document approval in particular) need a real auth provider decision.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // CRM business records.
    match /crm_accounts/{docId}    { allow read, write: if signedIn(); }
    match /crm_contacts/{docId}    { allow read, write: if signedIn(); }
    match /crm_leads/{docId}       { allow read, write: if signedIn(); }
    match /crm_activities/{docId}  { allow read, write: if signedIn(); }
    match /crm_tasks/{docId}       { allow read, write: if signedIn(); }
    match /opportunities/{docId}   { allow read, write: if signedIn(); }

    // Pricing, analysis and audit records.
    match /commercial_pricing_requests/{docId} { allow read, write: if signedIn(); }
    match /project_analyses/{docId}            { allow read, write: if signedIn(); }
    match /duplicate_override_audits/{docId}   { allow read, write: if signedIn(); }
    // Immutable audit logs. Only the server writes them, through the Admin SDK,
    // which bypasses these rules — so create/update/delete stay denied to every
    // client. Reads remain open to a signed-in caller because the admin audit
    // view loads them directly.
    match /audit_logs/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Server-owned collections.
    //
    // These are written by the server through the Admin SDK, which authenticates
    // as the project and bypasses these rules entirely. Denying clients here is
    // therefore not a restriction on the app — it is the point.
    //
    // user_profiles holds PIN hashes. PINs are short, so a readable hash is a
    // crackable hash; no client may read this collection at all.
    match /user_profiles/{docId} { allow read, write: if false; }

    // sessions are signed-in sessions, keyed by a hash of the bearer token.
    // A readable session is an impersonatable one, so this is denied outright;
    // the server reaches it through the Admin SDK.
    match /sessions/{docId} { allow read, write: if false; }

    // Quotes, pricing and notifications are server-owned so that a stale browser
    // tab cannot overwrite them directly, the failure mode that dismantled
    // syncBatchToCloud. Clients reach them through the REST endpoints.
    match /crm_deals/{docId}            { allow read, write: if false; }
    match /quote_documents/{docId}      { allow read, write: if false; }
    match /competitor_pricing/{docId}   { allow read, write: if false; }
    match /competitor_alerts/{docId}    { allow read, write: if false; }
    match /notifications/{docId}        { allow read, write: if false; }

    // Workspace configuration and profiles.
    match /settings/{docId} { allow read, write: if signedIn(); }
    match /users/{docId}    { allow read, write: if signedIn(); }

    // knowledge_documents and controlled_documents backed the reference-document
    // library, which has been removed. No code reads them, so they fall through
    // to the default deny below rather than staying open to any signed-in
    // caller. Any historical records remain in Firestore, unreachable by the app.

    // Connectivity probe used by checkCloudHealth().
    match /system_health/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Anything not named above is denied rather than silently world-open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
