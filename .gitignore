node_modules/
build/
# The desktop shell's build resources are source, not output: the icon and the
# script that draws it. The blanket build/ rule above would swallow them.
!desktop/build/
# Installers produced by electron-builder.
desktop/release/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
test-results/
playwright-report/
server_data_*.json
controlled-documents-backup-*.json
imported-accounts-backup-*.json
.claude/
# Runtime state written by the server as it runs, not source. These were
# tracked, so every test run and every local session rewrote ids and
# timestamps and dirtied the tree. The stores seed an empty array and create
# the file when it is missing, so nothing needs to be checked in.
server_data/*.json
# Uploaded quote PDFs are customer documents, not source.
server_data/quote_documents/
tmp/
.codex-remote-attachments/
